---
// Head override: renders Starlight's own <head> tags (title, description,
// canonical, hreflang alternates, generator — unchanged, minus the basic OG/
// Twitter tags Starlight also emits, which we drop to avoid duplicates) and
// then appends the social/SEO metadata Starlight doesn't ship: Open Graph,
// Twitter Card, theme-color (Discord embed accent), and WebSite +
// SoftwareApplication JSON-LD. (@astrojs/sitemap injects its own sitemap <link>.)
//
// Every value derives from the current route so each page gets its own
// title/description in its card, while sharing the one site-wide OG image
// (public/og-image.png, generated by scripts/gen-og.mjs).
import splash from "../data/splash.json";

const { head, entry, entryMeta } = Astro.locals.starlightRoute;

// Starlight 0.40 already emits a basic set of OG + Twitter tags (og:title, og:type,
// og:url, og:locale, og:description, og:site_name, twitter:card). Drop those so the
// fuller per-page set we emit below is authoritative — no conflicting duplicates.
const filteredHead = head.filter((h) => {
  const p = h.attrs?.property;
  const n = h.attrs?.name;
  if (typeof p === "string" && p.startsWith("og:")) return false;
  if (typeof n === "string" && n.startsWith("twitter:")) return false;
  return true;
});
const SITE_NAME = splash.hero.title.en; // "Maker Studio"
const SITE_DESCRIPTION =
  splash.hero.metaDescription.en; // plain-prose site description (EN)
const TWITTER = "@Toskan4134";
const THEME_COLOR = "#1e1e2e";

const pageTitle = entry.data.title as string | undefined;
const pageDescription =
  (entry.data.description as string | undefined) || SITE_DESCRIPTION;
const isSplash = (entry.data as any).template === "splash";

// Locale → OG locale code. entryMeta.locale is the root-locale slug ("en" root
// or "es"); currentLocale matches.
const loc = (Astro.currentLocale || entryMeta?.locale || "en").startsWith("es")
  ? "es"
  : "en";
const OG_LOCALE = loc === "es" ? "es_ES" : "en_US";
const OG_LOCALE_ALT = loc === "es" ? "en_US" : "es_ES";

// Absolute canonical URL + image URL. Astro.url already carries the site +
// base. For assets we join BASE_URL ourselves — but BASE_URL only carries a
// trailing slash when base is the default "/", so normalize it to guarantee
// exactly one slash between base and the filename (works under any versioned base).
const base = import.meta.env.BASE_URL.replace(/\/+$/, ""); // "" or "/maker-studio"
const assetUrl = (name: string) =>
  new URL(`${base}/${name}`, Astro.site).toString();
const canonical = Astro.url.toString();
const ogImage = assetUrl("og-image.png");
const logoUrl = assetUrl("logo.png");
const homeUrl = new URL(`${base}/`, Astro.site).toString();

// Home/splash pages have a generic page title ("Home"); lead with the brand
// name there. Every other page leads with its own title.
const ogTitle = isSplash ? SITE_NAME : pageTitle || SITE_NAME;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${homeUrl}#website`,
      name: SITE_NAME,
      url: homeUrl,
      description: SITE_DESCRIPTION,
      publisher: { "@id": `${homeUrl}#app` },
      inLanguage: loc,
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${homeUrl}#app`,
      name: SITE_NAME,
      url: homeUrl,
      description: SITE_DESCRIPTION,
      applicationCategory: "DesignApplication",
      operatingSystem: "Windows, macOS, Linux",
      image: logoUrl,
      logo: logoUrl,
      author: { "@type": "Person", name: "Toskan4134", url: "https://x.com/Toskan4134" },
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      inLanguage: loc,
    },
  ],
};
---

{
  /* 1. Starlight's own head tags — rendered exactly as the default Head.astro does
     (OG/Twitter ones filtered out above so ours below are the only copy). */
  filteredHead.map(({ tag: Tag, attrs, content }) => (
    <Tag {...attrs} set:html={content} />
  ))
}

{/* 2. Open Graph */}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE_NAME} — ${SITE_DESCRIPTION}`} />
<meta property="og:locale" content={OG_LOCALE} />
<meta property="og:locale:alternate" content={OG_LOCALE_ALT} />

{/* 3. Twitter Card */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={TWITTER} />
<meta name="twitter:creator" content={TWITTER} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={`${SITE_NAME} — ${SITE_DESCRIPTION}`} />

{/* 4. Discord/Chrome embed accent + SEO helpers. (@astrojs/sitemap already
     injects its own <link rel="sitemap"> pointing at the index, so no need to
     add one here.) */}
<meta name="theme-color" content={THEME_COLOR} />
<meta name="application-name" content={SITE_NAME} />
<meta name="author" content="Toskan4134" />

{/* 5. Structured data for rich search results */}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
