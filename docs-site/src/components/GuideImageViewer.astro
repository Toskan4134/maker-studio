---
import MarkdownContent from "@astrojs/starlight/components/MarkdownContent.astro";

const showViewer = Astro.locals.starlightRoute.entry.body?.includes("/guide-media/");
const isSpanish = Astro.currentLocale === "es";
const title = isSpanish ? "Imagen ampliada" : "Enlarged image";
const closeLabel = isSpanish ? "Cerrar imagen" : "Close image";
---

<MarkdownContent><slot /></MarkdownContent>

{showViewer && (
  <dialog id="guide-image-viewer" class="guide-image-viewer" aria-label={title}>
    <form method="dialog">
      <button type="submit" aria-label={closeLabel} autofocus>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </form>
  </dialog>
)}

<script>
  const viewer = document.querySelector<HTMLDialogElement>("#guide-image-viewer");

  if (viewer?.showModal) {
    const image = new Image();
    let opener: HTMLAnchorElement | undefined;

    document.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (!(event.target instanceof Element)) return;

      const link = event.target.closest<HTMLAnchorElement>(".sl-markdown-content a[href]");
      const thumbnail = link?.querySelector<HTMLImageElement>('img[src*="/guide-media/"]');
      if (!thumbnail?.naturalWidth || !link || link.href !== thumbnail.src) return;

      event.preventDefault();
      opener = link;
      image.alt = thumbnail.alt;
      image.src = link.href;
      viewer.style.setProperty("--image-width", `${Math.max(thumbnail.naturalWidth, thumbnail.clientWidth * 1.6)}px`);
      viewer.style.setProperty("--image-ratio", String(thumbnail.naturalWidth / thumbnail.naturalHeight));
      viewer.append(image);
      viewer.showModal();
    });

    viewer.addEventListener("click", (event) => {
      if (event.target === viewer) viewer.close();
    });

    viewer.addEventListener("close", () => {
      opener?.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .guide-image-viewer {
    inline-size: min(var(--image-width), calc(100vw - 1rem), calc((100dvh - 5rem) * var(--image-ratio)));
    max-inline-size: none;
    max-block-size: none;
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .guide-image-viewer::backdrop {
    background: var(--sl-color-backdrop-overlay);
  }

  .guide-image-viewer form {
    inline-size: fit-content;
    margin-inline-start: auto;
    margin-block-end: 0.5rem;
  }

  .guide-image-viewer button {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--ms-radius-control);
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    cursor: pointer;
  }

  .guide-image-viewer button:hover {
    background: var(--ms-surface-hover);
  }

  .guide-image-viewer button:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .guide-image-viewer > :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--ms-radius-panel);
    box-shadow: var(--sl-shadow-md);
  }

  :global(html:has(#guide-image-viewer[open])) {
    overflow: hidden;
  }
</style>
